# ---------------------------------------------------------------------------
# The Developer Room — example environment configuration
# Copy this file to `.env.local` and adjust values. `.env*` files are git-ignored.
#
# IMPORTANT: Every VITE_* variable is embedded into the public JavaScript bundle.
# Never put secrets, API keys, passwords or tokens in these variables.
# ---------------------------------------------------------------------------

# Base URL of an optional backend (e.g. a Spring Boot API). Leave empty for the
# fully static, frontend-only portfolio. Example: https://api.example.com
VITE_API_BASE_URL=

# When "true" AND VITE_API_BASE_URL is set, portfolio content is fetched from
# GET {VITE_API_BASE_URL}/api/portfolio and falls back to local data on failure.
VITE_USE_REMOTE_PORTFOLIO=false

# Contact form mode: "demo" (default, nothing is delivered) or "api"
# (POST {VITE_API_BASE_URL}/api/contact). "api" requires VITE_API_BASE_URL.
VITE_CONTACT_MODE=demo

# Public base path for deployment under a sub-folder, e.g. "/my-portfolio/"
# for GitHub Pages project sites. Defaults to "/".
VITE_BASE_PATH=/
