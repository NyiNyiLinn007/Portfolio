{
  "name": "developer-room-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Developer Room — an immersive, interactive 3D developer portfolio built with React, Three.js and React Three Fiber.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
